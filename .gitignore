# ==============================================================================
# CloudStoreX Root .gitignore
# ==============================================================================

# Go Binaries and Build Artifacts
bin/
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.prof

# Go Vendor and Caches
vendor/
go.work
go.work.sum

# Node.js and Next.js Frontend
node_modules/
.next/
out/
build/
dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.vercel

# Testing & Coverage
*.out
*.coverprofile
coverage.html
.nyc_output

# Environment Variables & Secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
*.cert

# Docker & Container Data
postgres_data/
redis_data/
minio_data/
docker-compose.override.yml
*.log

# IDE & Editor Directories
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
*.sublime-workspace
*.sublime-project

# OS Metadata
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Terraform
.terraform/
*.tfstate
*.tfstate.*
crash.log
crash.*.log
*.tfvars
!*.tfvars.example
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc
